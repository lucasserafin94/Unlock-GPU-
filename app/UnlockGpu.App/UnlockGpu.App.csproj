<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>UnlockGpu.App</RootNamespace>
    <AssemblyName>UnlockGPU</AssemblyName>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms is used only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\assets\UnlockGPU.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003: DPI awareness is declared in app.manifest on purpose; this is a WPF app and WinForms is used only for NotifyIcon. -->
    <!-- CA1822: VMs expose static firmware constants (CtgpOffsetMax/DbOffsetMax) as instance properties so XAML binds them via DataContext. -->
    <NoWarn>$(NoWarn);WFO0003;CA1822</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep WPF types unambiguous: WinForms/Drawing are referenced explicitly where needed (TrayIcon). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UnlockGpu.Core\UnlockGpu.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\logo-256.png" Link="Assets\logo-256.png" />
    <Resource Include="..\..\assets\UnlockGPU.ico" Link="Assets\UnlockGPU.ico" />
  </ItemGroup>
</Project>
