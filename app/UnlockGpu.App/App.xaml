<Application x:Class="UnlockGpu.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:UnlockGpu.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
            <conv:InverseBoolConverter x:Key="Not"/>
            <conv:TextToVisibilityConverter x:Key="TextToVis"/>
            <conv:ValueEqualsConverter x:Key="Equals"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
