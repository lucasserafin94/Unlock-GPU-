<Window x:Class="UnlockGpu.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:UnlockGpu.App.Localization"
        xmlns:v="clr-namespace:UnlockGpu.App.Views"
        Title="{l:Tr app.name}" Width="640" Height="770" MinWidth="640" MinHeight="600"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" Icon="pack://application:,,,/Assets/UnlockGPU.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- title bar (drag area is provided by WindowChrome) -->
            <Grid Background="{StaticResource TitleBarBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="pack://application:,,,/Assets/logo-256.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{l:Tr app.name}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource TextFaintBrush}" FontSize="11" Margin="6,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="OnMinimizeClick" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{l:Tr ui.window.minimize}" AutomationProperties.Name="{l:Tr ui.window.minimize}"/>
                    <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="OnCloseClick" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{l:Tr ui.window.close}" AutomationProperties.Name="{l:Tr ui.window.close}"/>
                </StackPanel>
            </Grid>

            <!-- header -->
            <Grid Grid.Row="1" Margin="14,10,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding GpuName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding HeaderDetail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
            </Grid>

            <!-- main banner -->
            <v:BannerView Grid.Row="2" Margin="12,0,12,0" DataContext="{Binding Banner}"/>

            <!-- tabs -->
            <TabControl Grid.Row="3">
                <TabItem Header="{l:Tr ui.tab.monitor}">
                    <v:MonitorView DataContext="{Binding Monitor}"/>
                </TabItem>
                <TabItem Header="{l:Tr ui.tab.tuning}">
                    <v:TuningView DataContext="{Binding Tuning}"/>
                </TabItem>
                <TabItem Header="{l:Tr ui.tab.autotune}">
                    <v:AutoTuneView DataContext="{Binding AutoTune}"/>
                </TabItem>
                <TabItem Header="{l:Tr ui.tab.sessions}">
                    <v:SessionsView DataContext="{Binding Sessions}"/>
                </TabItem>
                <TabItem Header="{l:Tr ui.tab.profiles}">
                    <v:ProfilesView DataContext="{Binding Profiles}"/>
                </TabItem>
                <TabItem Header="{l:Tr ui.tab.oem}">
                    <v:OemView DataContext="{Binding Oem}"/>
                </TabItem>
                <TabItem Header="{l:Tr ui.tab.rom}">
                    <v:RomView DataContext="{Binding Rom}"/>
                </TabItem>
                <TabItem Header="{l:Tr ui.tab.settings}">
                    <v:SettingsView DataContext="{Binding Settings}"/>
                </TabItem>
            </TabControl>

            <!-- footer -->
            <Border Grid.Row="4" Background="{StaticResource TitleBarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- hardware versus active profile -->
                    <TextBlock Grid.Column="1" DataContext="{Binding Drift}" Text="{Binding Text}" Margin="14,0,10,0" FontSize="11.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="30000">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                <Setter Property="ToolTip" Value="{Binding Text}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDrift}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                        <Setter Property="ToolTip" Value="{Binding Detail}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" DataContext="{Binding Drift}" VerticalAlignment="Center">
                        <Button Content="{l:Tr ui.drift.reset}" Command="{Binding ResetCommand}" ToolTip="{l:Tr ui.drift.resetHint}"
                                Padding="10,2" MinHeight="0" FontSize="11.5" Margin="0,0,6,0"/>
                        <Button Content="{l:Tr ui.drift.apply}" Command="{Binding ApplyCommand}" ToolTip="{l:Tr ui.drift.applyHint}"
                                Style="{StaticResource AccentButton}" Padding="10,2" MinHeight="0" FontSize="11.5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding HealthText}" ToolTipService.ShowDuration="30000">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HealthLevel}" Value="Warning">
                                            <Setter Property="Fill" Value="{StaticResource WarnBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HealthLevel}" Value="Critical">
                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Margin="7,0,0,0" FontSize="11.5" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{l:Tr ui.health.labelGood}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HealthLevel}" Value="Warning">
                                            <Setter Property="Text" Value="{l:Tr ui.health.labelWarning}"/>
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HealthLevel}" Value="Critical">
                                            <Setter Property="Text" Value="{l:Tr ui.health.labelCritical}"/>
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center"
                                Visibility="{Binding Sessions.IsRecording, Converter={StaticResource BoolToVis}}">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Tr ui.sessions.recording}" FontSize="11.5" Foreground="{StaticResource DangerBrush}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
