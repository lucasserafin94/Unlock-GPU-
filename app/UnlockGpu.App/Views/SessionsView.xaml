<UserControl x:Class="UnlockGpu.App.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UnlockGpu.App.Localization">
    <Grid Margin="12,10,12,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- recorder -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{l:Tr ui.sessions.recordTitle}" Style="{StaticResource SectionTitle}"/>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                        <Button Content="{l:Tr ui.sessions.stop}" Command="{Binding StopCommand}" Margin="0,0,8,0" Style="{StaticResource DangerButton}"/>
                        <Button Content="{l:Tr ui.sessions.start}" Command="{Binding StartCommand}" Style="{StaticResource AccentButton}"/>
                    </StackPanel>
                    <TextBlock Text="{l:Tr ui.sessions.label}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRecording, Converter={StaticResource Not}}"
                             AutomationProperties.Name="{l:Tr ui.sessions.label}"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:Tr ui.sessions.recording}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="6,0,8,0"/>
                    <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="420"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Summary}" Margin="0,8,0,0" Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{l:Tr ui.sessions.loadNote}" Style="{StaticResource Note}"/>
            </StackPanel>
        </Border>

        <!-- files -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{l:Tr ui.sessions.refresh}" Command="{Binding RefreshCommand}"/>
                    <TextBlock Text="{l:Tr ui.sessions.listTitle}" Style="{StaticResource SectionTitle}" Margin="0"/>
                </DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" MinHeight="90">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Details}" FontSize="10.5" Foreground="{StaticResource TextFaintBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Right">
                    <Button Content="{l:Tr ui.sessions.openFolder}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0"/>
                    <Button Content="{l:Tr ui.sessions.reveal}" Command="{Binding RevealCommand}" Margin="0,0,8,0"/>
                    <Button Content="{l:Tr ui.sessions.export}" Command="{Binding ExportCommand}" Style="{StaticResource AccentButton}"/>
                </WrapPanel>
                <TextBlock Grid.Row="3" Text="{l:Tr ui.sessions.exportNote}" Style="{StaticResource Note}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
