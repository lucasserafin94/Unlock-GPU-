<UserControl x:Class="UnlockGpu.App.Views.OemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UnlockGpu.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,10,12,4">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{l:Tr ui.oem.refresh}" Command="{Binding RefreshCommand}"/>
                        <TextBlock Text="{l:Tr ui.oem.title}" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding IdentityText}" Style="{StaticResource Caption}" Visibility="{Binding IdentityText, Converter={StaticResource TextToVis}}"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding HasState, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{l:Tr ui.oem.valuesTitle}" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{l:Tr oem.readOnlyNote}" Style="{StaticResource Note}"/>
                </StackPanel>
            </Border>

            <!-- apply -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasState, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{l:Tr ui.oem.applyTitle}" Style="{StaticResource SectionTitle}"/>

                    <ItemsControl ItemsSource="{Binding ModeOptions}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="oemMode" Content="{Binding Label}" IsChecked="{Binding IsSelected}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- cTGP -->
                    <StackPanel Margin="0,12,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CtgpOffsetText}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <CheckBox Content="{l:Tr ui.oem.applyCtgp}" IsChecked="{Binding CtgpEnabled}"/>
                        </DockPanel>
                        <Slider Minimum="0" Maximum="{Binding CtgpOffsetMax}" Value="{Binding CtgpOffsetW}"
                                SmallChange="5" LargeChange="25" Margin="18,6,0,0"
                                IsEnabled="{Binding CtgpEnabled}" AutomationProperties.Name="{l:Tr ui.oem.applyCtgp}"/>
                    </StackPanel>

                    <!-- dynamic boost -->
                    <StackPanel Margin="0,12,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DbOffsetText}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <CheckBox Content="{l:Tr ui.oem.applyDb}" IsChecked="{Binding DbEnabled}"/>
                        </DockPanel>
                        <Slider Minimum="0" Maximum="{Binding DbOffsetMax}" Value="{Binding DbOffsetW}"
                                SmallChange="1" LargeChange="5" Margin="18,6,0,0"
                                IsEnabled="{Binding DbEnabled}" AutomationProperties.Name="{l:Tr ui.oem.applyDb}"/>
                    </StackPanel>

                    <Button Content="{l:Tr ui.oem.applyButton}" Command="{Binding ApplyCommand}" Style="{StaticResource AccentButton}"
                            HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    <TextBlock Text="{Binding ApplyStatusText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ApplyIsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Text="{l:Tr ui.oem.writesLater}" Style="{StaticResource Note}" Margin="2,0,2,4"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
