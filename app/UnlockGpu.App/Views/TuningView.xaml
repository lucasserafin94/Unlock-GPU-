<UserControl x:Class="UnlockGpu.App.Views.TuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UnlockGpu.App.Localization"
             xmlns:v="clr-namespace:UnlockGpu.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,10,12,4">
            <v:BannerView DataContext="{Binding ReadBack}"/>

            <!-- live applied → read-back confirmations -->
            <TextBlock Text="{Binding LiveLine}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"
                       Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding HasLiveLine, Converter={StaticResource BoolToVis}}"/>

            <!-- clock offsets -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr ui.offset.title}" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{l:Tr ui.offset.core}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="{Binding CoreMin}" Maximum="{Binding CoreMax}" Value="{Binding CoreOffset}"
                                SmallChange="15" LargeChange="150" IsEnabled="{Binding CoreAvailable}"
                                AutomationProperties.Name="{l:Tr ui.offset.core}"/>
                        <TextBlock Grid.Column="2" Text="{Binding CoreOffsetText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CoreRangeText}" Style="{StaticResource Caption}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Text="{l:Tr ui.offset.mem}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="{Binding MemMin}" Maximum="{Binding MemMax}" Value="{Binding MemOffset}"
                                SmallChange="15" LargeChange="150" IsEnabled="{Binding MemAvailable}"
                                AutomationProperties.Name="{l:Tr ui.offset.mem}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding MemOffsetText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MemRangeText}" Style="{StaticResource Caption}"/>
                    </Grid>
                    <DockPanel Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="{l:Tr ui.offset.reset}" Command="{Binding ResetOffsetsCommand}" Margin="0,0,8,0"/>
                            <Button Content="{l:Tr ui.offset.apply}" Command="{Binding ApplyOffsetsCommand}" Style="{StaticResource AccentButton}"/>
                        </StackPanel>
                        <TextBlock Text="{l:Tr ui.offset.pending}" Foreground="{StaticResource WarnBrush}" FontSize="11.5" VerticalAlignment="Center"
                                   Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
                    </DockPanel>
                    <TextBlock Text="{l:Tr ui.offset.note}" Style="{StaticResource Note}"/>
                </StackPanel>
            </Border>

            <!-- VRAM lock -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr ui.vram.title}" Style="{StaticResource SectionTitle}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="{l:Tr ui.vram.switch}" IsChecked="{Binding LockEnabled}"
                              IsEnabled="{Binding CanToggleLock}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{l:Tr ui.vram.level}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ItemsControl ItemsSource="{Binding Levels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="vramLevel" Content="{Binding Label}" IsChecked="{Binding IsSelected}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="{Binding LockStatus}" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <Border Style="{StaticResource WarningBox}">
                        <TextBlock Text="{l:Tr svc.vram.note.powerCapped}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- power limit -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr ui.power.title}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding PowerSupportText}" Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding PowerLimitsText}" Style="{StaticResource Note}"/>
                    <Grid Margin="0,8,0,0" Visibility="{Binding IsPowerAdjustable, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="{Binding PowerMin}" Maximum="{Binding PowerMax}" Value="{Binding PowerValue}" SmallChange="1" LargeChange="10"
                                AutomationProperties.Name="{l:Tr ui.power.title}"/>
                        <TextBlock Grid.Column="1" Text="{Binding PowerValueText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="{l:Tr ui.power.apply}" Command="{Binding ApplyPowerCommand}" Style="{StaticResource AccentButton}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- persistent power ceiling (driver shadow slots) -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasRomRoles, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{l:Tr ui.rom.title}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{l:Tr ui.rom.desc}" Style="{StaticResource Note}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="84"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{l:Tr ui.rom.max}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="5" Maximum="400" Value="{Binding MaxValue}" SmallChange="5" LargeChange="25"
                                IsEnabled="{Binding MaxEnabled}" AutomationProperties.Name="{l:Tr ui.rom.max}"/>
                        <TextBlock Grid.Column="2" Text="{Binding MaxValueText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock Text="{l:Tr ui.rom.base}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox Content="{l:Tr ui.rom.sync}" IsChecked="{Binding SyncBase}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="5" Maximum="400" Value="{Binding BaseValue}" SmallChange="5" LargeChange="25"
                                IsEnabled="{Binding BaseEnabled}" AutomationProperties.Name="{l:Tr ui.rom.base}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding BaseValueText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Text="{l:Tr ui.rom.nvvdd}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="30" Value="{Binding NvvddA}" SmallChange="0.5" LargeChange="2"
                                IsEnabled="{Binding NvvddEnabled}" AutomationProperties.Name="{l:Tr ui.rom.nvvdd}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding NvvddAText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="3" Text="{l:Tr ui.rom.msvdd}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="30" Value="{Binding MsvddA}" SmallChange="0.5" LargeChange="2"
                                IsEnabled="{Binding MsvddEnabled}" AutomationProperties.Name="{l:Tr ui.rom.msvdd}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding MsvddAText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="4" Text="{l:Tr ui.rom.boardInput}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="240" Value="{Binding BoardInputA}" SmallChange="1" LargeChange="10"
                                IsEnabled="{Binding BoardInputEnabled}" AutomationProperties.Name="{l:Tr ui.rom.boardInput}"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding BoardInputAText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <DockPanel Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="{l:Tr ui.rom.apply}" Command="{Binding ApplyPersistentCommand}" Style="{StaticResource AccentButton}"/>
                        </StackPanel>
                        <TextBlock Text="{l:Tr ui.rom.dirty}" Foreground="{StaticResource WarnBrush}" FontSize="11.5" VerticalAlignment="Center"
                                   Visibility="{Binding IsRomDirty, Converter={StaticResource BoolToVis}}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- budget -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr ui.budget.title}" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:Tr ui.budget.adapter}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBox Width="64" Margin="8,0,4,0" Text="{Binding AdapterWattsText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{l:Tr ui.budget.adapter}"/>
                        <TextBlock Text="W" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Tr ui.budget.reserve}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <TextBox Width="56" Margin="8,0,4,0" Text="{Binding ReserveWattsText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{l:Tr ui.budget.reserve}"/>
                        <TextBlock Text="W" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding BudgetText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BudgetLow}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{l:Tr ui.budget.note}" Style="{StaticResource Note}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
