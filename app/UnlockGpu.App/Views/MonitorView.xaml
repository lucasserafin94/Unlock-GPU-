<UserControl x:Class="UnlockGpu.App.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UnlockGpu.App.Localization"
             xmlns:c="clr-namespace:UnlockGpu.App.Controls">
    <Grid Margin="12,10,12,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- tiles -->
        <ItemsControl ItemsSource="{Binding Tiles}" Margin="-3,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="T" Margin="3" Padding="10,7" CornerRadius="6" BorderThickness="1"
                            Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" ToolTip="{Binding Sub}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <TextBlock x:Name="V" Text="{Binding Value}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding Unit}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" Margin="4,0,0,3"
                                           VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Sub}" FontSize="10.5" Foreground="{StaticResource TextFaintBrush}"
                                       TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Alert}" Value="True">
                            <Setter TargetName="T" Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
                            <Setter TargetName="V" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- read error -->
        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

        <!-- reason chips -->
        <StackPanel Grid.Row="2" Margin="0,8,0,8">
            <TextBlock Text="{l:Tr ui.monitor.reasons}" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding Chips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Chip" CornerRadius="10" Padding="9,2" Margin="0,0,6,4" BorderThickness="1"
                                Background="{StaticResource InfoSoftBrush}" BorderBrush="{StaticResource InfoBrush}" ToolTip="{Binding Tooltip}">
                            <TextBlock x:Name="ChipText" Text="{Binding Text}" FontSize="11.5" Foreground="{StaticResource InfoBrush}"/>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource WarnSoftBrush}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
                                <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Ok">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource OkSoftBrush}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource OkBrush}"/>
                                <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource OkBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- graph -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8,8,8,6" Margin="0,0,0,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="4,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="12" Height="3" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Tr ui.graph.power}" Style="{StaticResource Caption}" Margin="5,0,12,0"/>
                        <Rectangle Width="12" Height="3" Fill="{StaticResource CoreLineBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Tr ui.graph.core}" Style="{StaticResource Caption}" Margin="5,0,12,0"/>
                        <Rectangle Width="12" Height="3" Fill="{StaticResource MemLineBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Tr ui.graph.memRelative}" Style="{StaticResource Caption}" Margin="5,0,12,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <RadioButton Style="{StaticResource SegmentRadio}" GroupName="graphMinutes" Content="1 min"
                                     IsChecked="{Binding GraphMinutes, Converter={StaticResource Equals}, ConverterParameter=1}"/>
                        <RadioButton Style="{StaticResource SegmentRadio}" GroupName="graphMinutes" Content="3 min"
                                     IsChecked="{Binding GraphMinutes, Converter={StaticResource Equals}, ConverterParameter=3}"/>
                        <RadioButton Style="{StaticResource SegmentRadio}" GroupName="graphMinutes" Content="10 min"
                                     IsChecked="{Binding GraphMinutes, Converter={StaticResource Equals}, ConverterParameter=10}"/>
                    </StackPanel>
                </Grid>
                <c:PowerGraph Grid.Row="1" MinHeight="180"
                              Samples="{Binding GraphSamples}" Minutes="{Binding GraphMinutes}"
                              Culture="{Binding Culture, Source={x:Static l:TranslationSource.Instance}}"
                              Background="{StaticResource GraphBackgroundBrush}"
                              PowerBrush="{DynamicResource AccentBrush}" CoreBrush="{StaticResource CoreLineBrush}"
                              MemBrush="{StaticResource MemLineBrush}" LimitBrush="{StaticResource DangerBrush}"
                              GridBrush="{StaticResource BorderBrush}" TextBrush="{StaticResource TextFaintBrush}"
                              TooltipBackground="{StaticResource Panel2Brush}" TooltipForeground="{StaticResource TextBrush}"
                              PowerLabel="{l:Tr ui.graph.power}" CoreLabel="{l:Tr ui.graph.core}" MemLabel="{l:Tr ui.graph.mem}"
                              LimitLabel="{l:Tr ui.graph.limit}" NowLabel="{l:Tr ui.graph.now}" EmptyText="{l:Tr ui.graph.empty}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
