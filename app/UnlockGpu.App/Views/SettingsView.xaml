<UserControl x:Class="UnlockGpu.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UnlockGpu.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,10,12,4">
            <!-- language -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:Tr ui.settings.language}" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <TextBlock Text="{l:Tr ui.settings.languageNote}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"
                              VerticalAlignment="Center" AutomationProperties.Name="{l:Tr ui.settings.language}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NativeName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- accent -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr ui.settings.accent}" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding AccentPresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" ToolTip="{Binding}" Margin="0,0,8,0" Cursor="Hand"
                                        AutomationProperties.Name="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Sw" Width="28" Height="28" CornerRadius="14" Background="{Binding}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Sw" Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{l:Tr ui.settings.customAccent}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Width="90" Text="{Binding CustomAccent, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{l:Tr ui.settings.customAccent}"/>
                        <Button Content="{l:Tr ui.settings.applyAccent}" Command="{Binding ApplyCustomAccentCommand}" Margin="8,0,0,0"/>
                        <Border Width="22" Height="22" CornerRadius="11" Margin="10,0,0,0" Background="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{l:Tr ui.settings.accentInvalid}" Foreground="{StaticResource DangerBrush}" FontSize="11.5" Margin="0,4,0,0"
                               Visibility="{Binding CustomAccentInvalid, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- monitor -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr ui.settings.monitorTitle}" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{l:Tr ui.settings.refresh}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding RefreshOptions}" SelectedItem="{Binding RefreshSeconds}"
                                  AutomationProperties.Name="{l:Tr ui.settings.refresh}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat={}{0} s}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Row="1" Text="{l:Tr ui.settings.graphMinutes}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding GraphOptions}" SelectedItem="{Binding GraphMinutes}" Margin="0,8,0,0"
                                  AutomationProperties.Name="{l:Tr ui.settings.graphMinutes}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat={}{0} min}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- behaviour -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr ui.settings.behaviourTitle}" Style="{StaticResource SectionTitle}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="{l:Tr ui.settings.minimizeToTray}" IsChecked="{Binding MinimizeToTray}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="{l:Tr ui.settings.reapply}" IsChecked="{Binding ReapplyAfterDriverReset}" Margin="0,10,0,0"/>
                    <TextBlock Text="{l:Tr ui.settings.reapplyNote}" Style="{StaticResource Note}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
