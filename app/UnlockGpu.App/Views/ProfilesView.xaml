<UserControl x:Class="UnlockGpu.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:UnlockGpu.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,10,12,4">
            <!-- list -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr ui.profiles.title}" Style="{StaticResource SectionTitle}"/>
                    <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Height="170">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Saved}" FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" Margin="8,2,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{l:Tr ui.profiles.empty}" Style="{StaticResource Note}"
                               Visibility="{Binding HasProfiles, Converter={StaticResource InverseBoolToVis}}"/>
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="{l:Tr ui.profiles.delete}" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,0"/>
                            <Button Content="{l:Tr ui.profiles.apply}" Command="{Binding ApplyCommand}" Style="{StaticResource AccentButton}"/>
                        </StackPanel>
                        <Button Content="{l:Tr ui.profiles.reset}" Command="{Binding ResetDefaultsCommand}" HorizontalAlignment="Left"
                                ToolTip="{l:Tr ui.profiles.resetHint}"/>
                    </DockPanel>
                    <TextBlock Text="{l:Tr ui.profiles.saveTitle}" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{l:Tr ui.profiles.saveCurrent}" Command="{Binding SaveCurrentCommand}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr ui.profiles.saveTitle}"/>
                    </DockPanel>
                    <TextBlock Text="{l:Tr ui.profiles.saveNote}" Style="{StaticResource Note}"/>
                </StackPanel>
            </Border>

            <!-- startup -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr ui.profiles.startupTitle}" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Tr ui.profiles.startupProfile}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding StartupProfile}"
                                  AutomationProperties.Name="{l:Tr ui.profiles.startupProfile}"/>
                    </Grid>
                    <CheckBox Style="{StaticResource Switch}" Content="{l:Tr ui.profiles.startWithWindows}" IsChecked="{Binding StartWithWindows}"
                              Margin="0,10,0,0" IsEnabled="{Binding StartupBusy, Converter={StaticResource Not}}"/>
                    <TextBlock Text="{l:Tr ui.profiles.startupNote}" Style="{StaticResource Note}"/>
                </StackPanel>
            </Border>

            <!-- backup -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr ui.backup.title}" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{l:Tr ui.backup.export}" Command="{Binding ExportBackupCommand}" Margin="0,0,8,0"/>
                        <Button Content="{l:Tr ui.backup.import}" Command="{Binding ImportBackupCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{l:Tr ui.backup.note}" Style="{StaticResource Note}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
