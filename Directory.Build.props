<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>4.3.1</Version>
    <Company>Unlock GPU</Company>
    <Product>Unlock GPU</Product>
    <Copyright>Unlock GPU</Copyright>
    <Deterministic>true</Deterministic>
    <!-- CA1416 (plataforma) nao se aplica: o produto e so Windows. CA1848/CA1805/CA1303 sao ruido para este app. -->
    <!-- CA1716: nomes como Stop/Get/Error conflitam so com palavras do VB; o produto e C#. -->
    <NoWarn>$(NoWarn);CA1416;CA1848;CA1303;CA1805;CA1031;CA1716</NoWarn>
  </PropertyGroup>
</Project>
